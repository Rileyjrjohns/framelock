# Gradle / build
.gradle/
.kotlin/
build/
local.properties
captures/

# IDE (bin/ and .project/.classpath/.settings come from the VS Code Java extension)
bin/
.project
.classpath
.settings/
.vscode/
.idea/
*.iml
.DS_Store

# Signing material and keys (scripts/sign-model.sh keeps its private key out of the repo)
*.jks
*.keystore
*.pem
# Public keys are meant to be committed: the release key goes in app/src/main/assets/keys/ (README, "Models").
!app/src/main/assets/keys/*.pub.pem
*.p12
*.key
*.der
*.pk8
*.p8
*.priv
*keystore.properties
signing.properties
.env*
keys/
!app/src/main/assets/keys/

# Performance runs (M7): traces are large and stay local; the input video is never committed (scripts/perf/)
*.perfetto-trace
*.mp4

# Model binaries are downloaded and signed locally, not committed (app/src/debug/assets/{models,keys})
*.tflite
*.flmodel
